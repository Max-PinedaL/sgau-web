{
  "name": "sgau-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server.mjs",
    "dev": "node scripts/dev.mjs",
    "test": "node --test test/*.test.mjs",
    "check": "node --check server.mjs && node --check src/app.mjs && node --check src/policy.mjs && npm run build",
    "build": "vite build",
    "prestart": "npm run build",
    "predev": "npm run build",
    "test:browser": "npm run build && node test/browser.mjs"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "vite": "^8.3.4"
  }
}
